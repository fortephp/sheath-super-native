{
    "name": "fortephp/sheath-super-native",
    "description": "Sheath rules for NativePHP Mobile Blade views: native element, class, and idiom linting for super native templates.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "blade linter"
    ],
    "authors": [
        {
            "name": "John Koster",
            "email": "john@stillat.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "fortephp/sheath": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3",
        "laravel/pint": "^1.22",
        "phpstan/phpstan": "^2.1",
        "nativephp/mobile": "^4.0",
        "rector/rector": "^2.6"
    },
    "suggest": {
        "nativephp/mobile": "The compiler these rules lint for. When installed, class and element tables are reflected from it instead of the bundled snapshot."
    },
    "autoload": {
        "psr-4": {
            "Forte\\Sheath\\NativePhp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Forte\\Sheath\\NativePhp\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Fixtures"
        ]
    },
    "scripts": {
        "test": "pest --do-not-cache-result",
        "analyse": "phpstan analyse --no-progress",
        "format:test": "pint --test",
        "rector": "rector process --dry-run --no-progress-bar"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Forte\\Sheath\\NativePhp\\ServiceProvider"
            ]
        }
    }
}